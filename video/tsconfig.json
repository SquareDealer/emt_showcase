{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@crm/*": ["../client/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "lucide-react": ["./node_modules/lucide-react"],
      "date-fns": ["./node_modules/date-fns"],
      "date-fns/*": ["./node_modules/date-fns/*"],
      "@dnd-kit/core": ["./node_modules/@dnd-kit/core"],
      "@dnd-kit/sortable": ["./node_modules/@dnd-kit/sortable"],
      "@dnd-kit/utilities": ["./node_modules/@dnd-kit/utilities"]
    }
  },
  "include": ["src", "scripts", "remotion.config.ts"]
}
